---
const { title = "Fernando Quispe | Software Engineer & Data/AI Specialist" } = Astro.props;
import Header from '../components/header.astro';
import Hero from '../components/hero.astro';
import AboutMe from '../components/about-me.astro';
import StatsBanner from '../components/stats-banner.astro';
import DataArchitecture from '../components/data-architecture.astro';
import Skills from '../components/skills.astro';
import Projects from '../components/projects.astro';
import Experience from '../components/experience.astro';
import Contact from '../components/contact.astro';
import Footer from '../components/footer.astro';
---

<!DOCTYPE html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/images/icon-fdaniel13s.webp" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content="Portafolio profesional de Fernando Quispe (Fernando.dev). Software Engineer especializado en Data Science, Data Engineering, Lakehouse, Streaming con Kafka/Spark y GenAI / LLMs." />
    <meta name="keywords" content="Fernando Quispe, Fernando.dev, fdaniel13s, Data Engineer, Data Science, AI Specialist, Apache Spark, Kafka, Python, PyTorch, LangChain, Lima Peru" />
    <meta name="author" content="Fernando Daniel Quispe Condori" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Fernando Quispe | Software Engineer & Data/AI Specialist" />
    <meta property="og:description" content="Portafolio de proyectos de alto impacto en Data Science, Data Engineering e Inteligencia Artificial." />
    <meta property="og:image" content="/images/fernando-quispe.jpg" />

    <!-- Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>

  <body class="bg-zinc-950 text-zinc-100 font-sans min-h-screen flex flex-col antialiased selection:bg-cyan-500/20 selection:text-cyan-300 relative overflow-x-hidden">
    
    <!-- Subtle Background Ambient Light & Minimal Grid -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <!-- Soft Top Radial Vignette -->
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[400px] bg-cyan-500/5 rounded-full blur-[140px]"></div>
      
      <!-- Minimalist Grid Pattern -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(ellipse_70%_50%_at_50%_0%,#000_60%,transparent_100%)]"></div>
    </div>

    <!-- Main Content Container -->
    <div class="relative z-10 flex flex-col flex-1 w-full">
      <Header />
      
      <main class="flex-1 w-full">
        <Hero />
        <AboutMe />
        <StatsBanner />
        <DataArchitecture />
        <Skills />
        <Projects />
        <Experience />
        <Contact />
        <slot />
      </main>

      <Footer />
    </div>

  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }
  
  html {
    scroll-behavior: smooth;
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  }

  /* Minimalist Zinc Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #09090b;
  }
  ::-webkit-scrollbar-thumb {
    background: #27272a;
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #3f3f46;
  }
</style>