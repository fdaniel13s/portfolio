---
const { title = "Fernando Quispe | FolioX Data & AI Portfolio" } = Astro.props;
import Header from '../components/header.astro';
import Hero from '../components/hero.astro';
import AboutMe from '../components/about-me.astro';
import StatsBanner from '../components/stats-banner.astro';
import DataArchitecture from '../components/data-architecture.astro';
import Skills from '../components/skills.astro';
import Projects from '../components/projects.astro';
import Experience from '../components/experience.astro';
import Contact from '../components/contact.astro';
import Footer from '../components/footer.astro';
---

<!DOCTYPE html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/images/icon-fdaniel13s.webp" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content="FolioX - Portafolio profesional de Fernando Quispe. Software Engineer especializado en Data Science, Data Engineering, Lakehouse, Streaming con Kafka/Spark y GenAI / LLMs." />
    <meta name="keywords" content="Fernando Quispe, FolioX, Data Engineer, Data Science, AI Specialist, Apache Spark, Kafka, Python, PyTorch, LangChain, Lima Peru" />
    <meta name="author" content="Fernando Daniel Quispe Condori" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Fernando Quispe | FolioX Data & AI Specialist" />
    <meta property="og:description" content="Portafolio de proyectos de alto impacto en Data Science, Data Engineering e Inteligencia Artificial." />
    <meta property="og:image" content="/images/fernando-quispe.jpg" />

    <!-- Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>

  <body class="bg-gradient-to-b from-cosmic-950 via-cosmic-900 to-cosmic-850 text-neutral-100 font-sans min-h-screen flex flex-col antialiased selection:bg-neon-cyan selection:text-cosmic-950 relative overflow-x-hidden">
    
    <!-- Cosmic Background Glowing Dust & Ambient Light (FolioX exact atmosphere) -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <!-- Top Radial Neon Glow -->
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-gradient-to-b from-neon-cyan/15 via-neon-purple/10 to-transparent rounded-full blur-[120px]"></div>
      
      <!-- Mid Purple Ambient Glow -->
      <div class="absolute top-[35%] -left-32 w-[600px] h-[600px] bg-cosmic-border/30 rounded-full blur-[140px]"></div>
      <div class="absolute top-[65%] -right-32 w-[600px] h-[600px] bg-neon-cyan/10 rounded-full blur-[140px]"></div>

      <!-- Subtle Cosmic Starry Dots / Grid -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#382E8015_1px,transparent_1px),linear-gradient(to_bottom,#382E8015_1px,transparent_1px)] bg-[size:40px_40px] opacity-70"></div>
    </div>

    <!-- Main Content Container -->
    <div class="relative z-10 flex flex-col flex-1">
      <Header />
      
      <main class="flex-1">
        <Hero />
        <AboutMe />
        <StatsBanner />
        <DataArchitecture />
        <Skills />
        <Projects />
        <Experience />
        <Contact />
        <slot />
      </main>

      <Footer />
    </div>

  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }
  
  html {
    scroll-behavior: smooth;
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  }

  /* Custom Neon Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #0B0826;
  }
  ::-webkit-scrollbar-thumb {
    background: #392C87;
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #00D2FF;
  }
</style>