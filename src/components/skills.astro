---

<section id="skills" class="py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <div class="text-center max-w-3xl mx-auto mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800 text-teal-700 dark:text-teal-300 text-xs font-semibold uppercase tracking-wider mb-3">
      Stack Tecnológico
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 dark:text-white tracking-tight">
      Habilidades & Especialización Técnica
    </h2>
    <p class="mt-3 text-base text-neutral-600 dark:text-neutral-300">
      Herramientas, frameworks y metodologías para diseñar soluciones de datos robustas, mantenibles y de alto rendimiento.
    </p>
  </div>

  <!-- Skill Category Tabs -->
  <div class="flex flex-wrap justify-center gap-2 mb-8" id="skills-tabs">
    {skillCategories.map((cat, index) => (
      <button
        type="button"
        data-category={cat.id}
        class={`skill-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 flex items-center gap-2 ${
          index === 0
            ? "bg-teal-600 text-white shadow-md shadow-teal-600/20 active"
            : "bg-white/80 dark:bg-neutral-900/80 text-neutral-700 dark:text-neutral-300 border border-neutral-200/80 dark:border-neutral-800/80 hover:bg-neutral-100 dark:hover:bg-neutral-800"
        }`}
      >
        <span>{cat.icon}</span>
        <span>{cat.name}</span>
      </button>
    ))}
  </div>

  <!-- Category Content Panels -->
  <div id="skills-panels" class="relative">
    {skillCategories.map((cat, index) => (
      <div
        id={`panel-${cat.id}`}
        class={`skill-panel ${index === 0 ? "block" : "hidden"} transition-opacity duration-300`}
      >
        <div class="p-6 sm:p-8 rounded-3xl bg-white/70 dark:bg-neutral-900/70 backdrop-blur-md border border-neutral-200/80 dark:border-neutral-800/80 shadow-sm">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-6 mb-6 border-b border-neutral-100 dark:border-neutral-800">
            <div>
              <h3 class="text-xl font-bold text-neutral-900 dark:text-white flex items-center gap-2">
                <span>{cat.icon}</span>
                <span>{cat.name}</span>
              </h3>
              <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
                {cat.description}
              </p>
            </div>
            <span class="text-xs font-mono text-teal-600 dark:text-teal-400 bg-teal-50 dark:bg-teal-950/60 px-3 py-1 rounded-lg self-start sm:self-auto">
              {cat.skills.length} Tecnologías Dominadas
            </span>
          </div>

          <!-- Skills Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {cat.skills.map((skill) => (
              <div class="p-4 rounded-2xl bg-neutral-50/80 dark:bg-neutral-800/50 border border-neutral-200/60 dark:border-neutral-700/60 hover:border-teal-500/40 dark:hover:border-teal-500/40 transition-all duration-200 flex flex-col justify-between group">
                <div class="flex items-start justify-between gap-2 mb-2">
                  <span class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors">
                    {skill.name}
                  </span>
                </div>
                <div class="flex items-center justify-between pt-2 mt-auto border-t border-neutral-200/40 dark:border-neutral-700/40 text-[11px] font-mono">
                  <span class="text-neutral-500 dark:text-neutral-400">{skill.tag}</span>
                  <span class="text-teal-600 dark:text-teal-400 font-semibold">{skill.level}</span>
                </div>
              </div>
            ))}
          </div>

        </div>
      </div>
    ))}
  </div>
</section>

<script is:inline>
  function setupSkillsTabs() {
    const tabs = document.querySelectorAll('.skill-tab-btn');
    const panels = document.querySelectorAll('.skill-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetCategory = tab.getAttribute('data-category');

        // Reset all tabs
        tabs.forEach(t => {
          t.classList.remove('bg-teal-600', 'text-white', 'shadow-md', 'shadow-teal-600/20', 'active');
          t.classList.add('bg-white/80', 'dark:bg-neutral-900/80', 'text-neutral-700', 'dark:text-neutral-300', 'border', 'border-neutral-200/80', 'dark:border-neutral-800/80');
        });

        // Activate clicked tab
        tab.classList.remove('bg-white/80', 'dark:bg-neutral-900/80', 'text-neutral-700', 'dark:text-neutral-300', 'border');
        tab.classList.add('bg-teal-600', 'text-white', 'shadow-md', 'shadow-teal-600/20', 'active');

        // Hide all panels, show active panel
        panels.forEach(panel => {
          if (panel.id === `panel-${targetCategory}`) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
          } else {
            panel.classList.remove('block');
            panel.classList.add('hidden');
          }
        });
      });
    });
  }

  setupSkillsTabs();
  document.addEventListener('astro:page-load', setupSkillsTabs);
</script>