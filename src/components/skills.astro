  {
    id: "software-eng",
    name: "Software & APIs",
    icon: "💻",
    description: "Arquitectura de microservicios, APIs de alto rendimiento y clean code.",
    skills: [
      { name: "FastAPI & Pydantic", level: "Avanzado", tag: "APIs de Datos" },
      { name: "Java & Spring Boot", level: "Avanzado", tag: "Backend Enterprise" },
      { name: "C# & .NET Core", level: "Avanzado", tag: "Backend" },
