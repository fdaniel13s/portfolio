---

<section id="skills" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">
  
  <div class="text-center max-w-3xl mx-auto mb-16">
    <span class="text-neon-cyan font-bold text-sm tracking-wider uppercase">
      Tech Ecosystem
    </span>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mt-3 tracking-tight">
      Habilidades & Especialización Técnica
    </h2>
    <p class="mt-4 text-base text-neutral-300">
      Herramientas, frameworks y metodologías para diseñar soluciones de datos robustas, mantenibles y de alto rendimiento.
    </p>
  </div>

  <!-- Skill Category Tabs -->
  <div class="flex flex-wrap justify-center gap-3 mb-10" id="skills-tabs">
    {skillCategories.map((cat, index) => (
      <button
        type="button"
        data-category={cat.id}
        class={`skill-tab-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center gap-2 ${
          index === 0
            ? "bg-neon-cyan text-cosmic-950 shadow-neon-cyan active"
            : "bg-cosmic-card text-neutral-300 border border-cosmic-border hover:border-neon-cyan/40 hover:text-white"
        }`}
      >
        <span>{cat.icon}</span>
        <span>{cat.name}</span>
      </button>
    ))}
  </div>

  <!-- Category Content Panels -->
  <div id="skills-panels" class="relative">
    {skillCategories.map((cat, index) => (
      <div
        id={`panel-${cat.id}`}
        class={`skill-panel ${index === 0 ? "block" : "hidden"} transition-opacity duration-300`}
      >
        <div class="p-8 sm:p-10 rounded-3xl bg-cosmic-card/85 backdrop-blur-md border border-cosmic-border shadow-cosmic-card">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-8 border-b border-cosmic-border">
            <div>
              <h3 class="text-2xl font-bold text-white flex items-center gap-2.5">
                <span>{cat.icon}</span>
                <span>{cat.name}</span>
              </h3>
              <p class="text-sm text-neutral-300 mt-1">
                {cat.description}
              </p>
            </div>
            <span class="text-xs font-mono text-neon-cyan bg-cosmic-900 px-4 py-1.5 rounded-full border border-cosmic-border self-start sm:self-auto">
              {cat.skills.length} Tecnologías Dominadas
            </span>
          </div>

          <!-- Skills Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {cat.skills.map((skill) => (
              <div class="p-5 rounded-2xl bg-cosmic-900/90 border border-cosmic-border hover:border-neon-cyan/50 transition-all duration-200 flex flex-col justify-between group">
                <div class="mb-4">
                  <span class="text-base font-bold text-white group-hover:text-neon-cyan transition-colors">
                    {skill.name}
                  </span>
                </div>
                <div class="flex items-center justify-between pt-3 border-t border-cosmic-border/60 text-xs font-mono">
                  <span class="text-neutral-400">{skill.tag}</span>
                  <span class="text-neon-cyan font-semibold">{skill.level}</span>
                </div>
              </div>
            ))}
          </div>

        </div>
      </div>
    ))}
  </div>
</section>

<script is:inline>
  function setupSkillsTabs() {
    const tabs = document.querySelectorAll('.skill-tab-btn');
    const panels = document.querySelectorAll('.skill-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetCategory = tab.getAttribute('data-category');

        // Reset all tabs
        tabs.forEach(t => {
          t.classList.remove('bg-neon-cyan', 'text-cosmic-950', 'shadow-neon-cyan', 'active');
          t.classList.add('bg-cosmic-card', 'text-neutral-300', 'border', 'border-cosmic-border');
        });

        // Activate clicked tab
        tab.classList.remove('bg-cosmic-card', 'text-neutral-300', 'border');
        tab.classList.add('bg-neon-cyan', 'text-cosmic-950', 'shadow-neon-cyan', 'active');

        // Hide all panels, show active panel
        panels.forEach(panel => {
          if (panel.id === `panel-${targetCategory}`) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
          } else {
            panel.classList.remove('block');
            panel.classList.add('hidden');
          }
        });
      });
    });
  }

  setupSkillsTabs();
  document.addEventListener('astro:page-load', setupSkillsTabs);
</script>