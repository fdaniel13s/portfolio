---
// src/components/skills.astro
const skillCategories = [
  {
    id: "data-eng",
    name: "Data Engineering",
    icon: "⚡",
    description: "Diseño de pipelines ETL/ELT, streaming en tiempo real y arquitecturas Lakehouse.",
    skills: [
      { name: "Apache Spark / PySpark", level: "Avanzado", tag: "Big Data" },
      { name: "Apache Kafka", level: "Avanzado", tag: "Streaming" },
      { name: "Apache Airflow", level: "Intermedio+", tag: "Orquestación" },
      { name: "dbt (Data Build Tool)", level: "Avanzado", tag: "Transformación" },
      { name: "PostgreSQL / MySQL / DuckDB", level: "Avanzado", tag: "Bases de Datos" },
      { name: "Delta Lake / Medallion Arch", level: "Avanzado", tag: "Lakehouse" },
      { name: "Modelado Dimensional", level: "Avanzado", tag: "Data Modeling" },
      { name: "Docker & Contenedores", level: "Avanzado", tag: "Infraestructura" },
    ]
  },
  {
    id: "data-science",
    name: "Data Science & ML",
    icon: "📊",
    description: "Modelos predictivos, aprendizaje supervisado/no supervisado y análisis estadístico.",
    skills: [
      { name: "Python (NumPy, Pandas, SciPy)", level: "Avanzado", tag: "Core Data" },
      { name: "Scikit-Learn", level: "Avanzado", tag: "Machine Learning" },
      { name: "XGBoost & LightGBM", level: "Avanzado", tag: "Gradient Boosting" },
      { name: "PyTorch & Deep Learning", level: "Intermedio+", tag: "Redes Neuronales" },
      { name: "Series Temporales & Stats", level: "Intermedio+", tag: "Estadística" },
      { name: "SHAP & Explicabilidad ML", level: "Avanzado", tag: "Interpretability" },
      { name: "Feature Engineering", level: "Avanzado", tag: "Data Prep" },
      { name: "A/B Testing & Inferencia", level: "Intermedio+", tag: "Experimentación" },
    ]
  },
  {
    id: "gen-ai",
    name: "GenAI & LLMs",
    icon: "🤖",
    description: "Sistemas RAG multimodales, agentes autónomos y bases de datos vectoriales.",
    skills: [
      { name: "LangChain & LlamaIndex", level: "Avanzado", tag: "Frameworks LLM" },
      { name: "Vector DBs (Qdrant, Chroma)", level: "Avanzado", tag: "Embeddings" },
      { name: "RAG Híbrido & Reranking", level: "Avanzado", tag: "Search" },
      { name: "OpenAI & HuggingFace APIs", level: "Avanzado", tag: "Modelos" },
      { name: "Prompt Engineering", level: "Avanzado", tag: "Técnicas" },
      { name: "Computer Vision (YOLOv8)", level: "Intermedio+", tag: "Visión" },
    ]
  },
  {
    id: "mlops-cloud",
    name: "MLOps & Cloud",
    icon: "🔄",
    description: "Gobernanza, reproducibilidad, monitoreo y despliegue continuo de modelos y datos.",
    skills: [
      { name: "MLflow (Model Registry)", level: "Avanzado", tag: "ML Lifecycle" },
      { name: "Great Expectations", level: "Avanzado", tag: "Data Quality" },
      { name: "AWS (S3, Lambda, EC2)", level: "Intermedio+", tag: "Cloud" },
      { name: "GitHub Actions CI/CD", level: "Avanzado", tag: "Automatización" },
      { name: "DVC (Data Version Control)", level: "Intermedio+", tag: "Versionado" },
      { name: "Linux & Bash Scripting", level: "Avanzado", tag: "Sistemas" },
    ]
  },
  {
    id: "software-eng",
    name: "Software & APIs",
    icon: "💻",
    description: "Arquitectura de microservicios, APIs de alto rendimiento y clean code.",
    skills: [
      { name: "FastAPI & Pydantic", level: "Avanzado", tag: "APIs de Datos" },
      { name: "Java & Spring Boot", level: "Avanzado", tag: "Backend Enterprise" },
      { name: "C# & .NET Core", level: "Avanzado", tag: "Backend" },
