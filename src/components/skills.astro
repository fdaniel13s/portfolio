      { name: "Apache Kafka", level: "Avanzado", tag: "Streaming" },
      { name: "Apache Airflow", level: "Intermedio+", tag: "Orquestación" },
      { name: "dbt (Data Build Tool)", level: "Avanzado", tag: "Transformación" },
      { name: "PostgreSQL / MySQL / DuckDB", level: "Avanzado", tag: "Bases de Datos" },
      { name: "Delta Lake / Medallion Arch", level: "Avanzado", tag: "Lakehouse" },
      { name: "Modelado Dimensional", level: "Avanzado", tag: "Data Modeling" },
      { name: "Docker & Contenedores", level: "Avanzado", tag: "Infraestructura" },
    ]
  },
  {
    id: "data-science",
