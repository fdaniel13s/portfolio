---

<section id="skills" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full relative z-10">
  
  <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
      Stack Tecnológico
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
      Habilidades & Ecosistema Técnico
    </h2>
    <p class="mt-3 text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto">
      Organizado de forma transparente por áreas de aplicación, diferenciando tecnologías de experiencia real, proyectos construidos y áreas en aprendizaje activo.
    </p>
  </div>

  <!-- Skill Category Tabs -->
  <div class="flex flex-wrap justify-center items-center gap-2 sm:gap-2.5 mb-10 mx-auto" id="skills-tabs">
    {skillCategories.map((cat, index) => (
      <button
        type="button"
        data-category={cat.id}
        class={`skill-tab-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 flex items-center gap-2 ${
          index === 0
            ? "bg-white text-zinc-950 font-semibold shadow-sm active"
            : "bg-zinc-900/80 text-zinc-400 border border-zinc-800 hover:text-zinc-200 hover:border-zinc-700"
        }`}
      >
        <span>{cat.icon}</span>
        <span>{cat.name}</span>
      </button>
    ))}
  </div>

  <!-- Category Content Panels -->
  <div id="skills-panels" class="relative">
    {skillCategories.map((cat, index) => (
      <div
        id={`panel-${cat.id}`}
        class={`skill-panel ${index === 0 ? "block" : "hidden"} transition-opacity duration-300`}
      >
        <div class="p-6 sm:p-8 rounded-2xl bg-zinc-900/50 border border-zinc-800/80">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-800/80">
            <div>
              <h3 class="text-xl font-bold text-white flex items-center gap-2">
                <span>{cat.icon}</span>
                <span>{cat.name}</span>
              </h3>
              <p class="text-sm text-zinc-400 mt-1">
                {cat.description}
              </p>
            </div>
            <span class="text-xs font-mono text-cyan-400 bg-zinc-800 px-3 py-1 rounded-md border border-zinc-700/60 self-start sm:self-auto">
              {cat.skills.length} Tecnologías / Áreas
            </span>
          </div>

          <!-- Skills Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
            {cat.skills.map((skill) => (
              <div class="p-4 rounded-xl bg-zinc-950/70 border border-zinc-800/80 hover:border-zinc-700 transition-colors flex flex-col justify-between group">
                <div class="mb-3">
                  <h4 class="text-sm font-semibold text-zinc-200 group-hover:text-cyan-400 transition-colors">
                    {skill.name}
                  </h4>
                  <span class="text-xs text-zinc-400 mt-0.5 block">
                    {skill.tag}
                  </span>
                </div>
                <div class="flex items-center justify-between pt-2.5 border-t border-zinc-800/60 text-[11px] font-mono">
                  <span class="text-zinc-500">Contexto:</span>
                  <span class="text-cyan-400/90 font-medium">{skill.status}</span>
                </div>
              </div>
            ))}
          </div>

        </div>
      </div>
    ))}
  </div>
</section>

<script is:inline>
  function setupSkillsTabs() {
    const tabs = document.querySelectorAll('.skill-tab-btn');
    const panels = document.querySelectorAll('.skill-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetCategory = tab.getAttribute('data-category');

        // Reset all tabs
        tabs.forEach(t => {
          t.classList.remove('bg-white', 'text-zinc-950', 'font-semibold', 'shadow-sm', 'active');
          t.classList.add('bg-zinc-900/80', 'text-zinc-400', 'border', 'border-zinc-800');
        });

        // Activate clicked tab
        tab.classList.remove('bg-zinc-900/80', 'text-zinc-400', 'border', 'border-zinc-800');
        tab.classList.add('bg-white', 'text-zinc-950', 'font-semibold', 'shadow-sm', 'active');

        // Hide all panels, show active panel
        panels.forEach(panel => {
          if (panel.id === `panel-${targetCategory}`) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
          } else {
            panel.classList.remove('block');
            panel.classList.add('hidden');
          }
        });
      });
    });
  }

  setupSkillsTabs();
  document.addEventListener('astro:page-load', setupSkillsTabs);
</script>