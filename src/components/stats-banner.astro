---
// stats-banner.astro
const stats = [
  { value: "50k+", label: "Streaming Events / s", desc: "Throughput Kafka & Spark" },
  { value: "98.2%", label: "RAG Accuracy Rate", desc: "Multi-modal LLMs & Qdrant" },
  { value: "3K+", label: "Commits & Pipelines", desc: "Data Quality & Clean Code" },
  { value: "9+", label: "Production Stacks", desc: "Cloud, Lakehouse & AI" },
];
---

<section class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full relative z-10">
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    {stats.map((stat) => (
      <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/80 hover:border-zinc-700 transition-colors text-center">
        <div class="text-3xl sm:text-4xl font-extrabold font-mono text-cyan-400">
          {stat.value}
        </div>
        <div class="text-xs sm:text-sm font-semibold text-zinc-200 mt-1.5">
          {stat.label}
        </div>
        <div class="text-[11px] text-zinc-400 mt-0.5 font-mono">
          {stat.desc}
        </div>
      </div>
    ))}
  </div>
</section>
