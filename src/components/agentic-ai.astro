---
// src/components/agentic-ai.astro
const capabilities = [
  {
    icon: "📄",
    title: "Sistemas RAG & Búsqueda Vectorial",
    desc: "Indexación semántica de documentos no estructurados con bases de datos vectoriales (Qdrant / Chroma), segmentación contextual y recuperación aumentada libre de alucinaciones.",
    techs: ["Qdrant", "LangChain", "OpenAI / HuggingFace", "FastAPI"],
    projectLink: "#projects",
    projectLabel: "Ver Proyecto DocuMind"
  },
  {
    icon: "🛠️",
    title: "Tool Use & Invocación de Funciones",
    desc: "Integración de LLMs con APIs REST, consultas dinámicas a bases de datos SQL y ejecución controlada de herramientas para convertir modelos en agentes operativos.",
    techs: ["Function Calling", "Pydantic Schemas", "OpenAPI", "Python"],
  },
  {
    icon: "🔄",
    title: "Flujos de Trabajo Agénticos Multi-Paso",
    desc: "Experimentación con arquitecturas de agentes autónomos: bucles de planificación y ejecución, descomposición de tareas complejas y memoria conversacional.",
    techs: ["ReAct Patterns", "Agent Loops", "State Management", "LangGraph"],
  },
  {
    icon: "🔌",
    title: "Model Context Protocol (MCP) & Protocolos Abiertos",
    desc: "Exploración de estándares emergentes para conectar modelos de IA con herramientas del sistema de archivos, repositorios y servicios externos de manera segura y modular.",
    techs: ["MCP Servers", "Context Protocols", "System Integration"],
  }
];
---

<section id="agentic-ai" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full relative z-10">
  
  <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
      Exploración & Enfoque Activo
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
      AI Engineering & Agentic Systems
    </h2>
    <p class="mt-3 text-sm sm:text-base text-zinc-300 max-w-2xl mx-auto leading-relaxed">
      <span class="text-cyan-400 font-medium">"I am actively building and experimenting with AI systems and agents."</span>
      <br />
      Avanzando progresivamente hacia la ingeniería de inteligencia artificial y flujos agénticos sobre una base sólida de ingeniería de software.
    </p>
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
    {capabilities.map((item) => (
      <div class="p-6 sm:p-7 rounded-2xl bg-zinc-900/50 border border-zinc-800/80 hover:border-zinc-700 transition-all flex flex-col justify-between group">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">{item.icon}</span>
            <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-cyan-400 transition-colors">
              {item.title}
            </h3>
          </div>

          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-5">
            {item.desc}
          </p>
        </div>

        <div>
          <div class="pt-3 border-t border-zinc-800/60 flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap gap-1.5">
              {item.techs.map((tech) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-zinc-800/70 text-zinc-300 border border-zinc-700/40">
                  {tech}
                </span>
              ))}
            </div>

            {item.projectLink && (
              <a
                href={item.projectLink}
                class="text-xs font-mono font-medium text-cyan-400 hover:text-cyan-300 hover:underline"
              >
                {item.projectLabel} &rarr;
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Engineering Mindset Callout -->
  <div class="rounded-2xl bg-gradient-to-r from-zinc-900/80 via-zinc-900/50 to-zinc-950/80 border border-zinc-800 p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
    <div class="max-w-2xl">
      <div class="flex items-center gap-2 mb-1.5">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span class="text-xs font-mono uppercase tracking-wider text-cyan-400 font-semibold">
          Enfoque de Ingeniería de Software
        </span>
      </div>
      <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed">
        Trato las aplicaciones con LLMs y agentes como <strong>sistemas de software rigurosos</strong>: requieren validación estricta de esquemas (Pydantic / JSON Schema), manejo de timeouts, desacoplamiento, trazabilidad y control de costos en lugar de cajas negras.
      </p>
    </div>
    
    <a
      href="#projects"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-200 hover:text-white text-xs font-medium border border-zinc-700/60 transition-colors flex-shrink-0"
    >
      <span>Ver Proyectos de IA</span>
      <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>

</section>
