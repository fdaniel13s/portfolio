---
// hero.astro
---

<section id="aboutme" class="relative pt-28 pb-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <!-- Subtle Background Glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-teal-500/10 dark:bg-teal-500/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-72 h-72 bg-cyan-500/10 dark:bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative flex flex-col-reverse lg:flex-row items-center gap-12 lg:gap-16">
    
    <!-- Text Content -->
    <div class="flex-1 text-center lg:text-left">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200/80 dark:border-teal-800/80 text-teal-700 dark:text-teal-300 text-xs font-semibold tracking-wide mb-6">
        <span class="w-2 h-2 rounded-full bg-teal-500 animate-ping"></span>
        <span class="w-2 h-2 rounded-full bg-teal-500 -ml-4"></span>
        <span>Disponible para Proyectos & Roles de Datos e IA</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-neutral-900 dark:text-white leading-[1.15]">
        Hola, soy <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-500 via-cyan-500 to-blue-600">Fernando Quispe</span>
      </h1>

      <p class="mt-4 text-xl sm:text-2xl font-semibold text-neutral-700 dark:text-neutral-200">
        Ingeniero de Software & <span class="text-teal-600 dark:text-teal-400">Data & AI Specialist</span>
      </p>

      <p class="mt-4 text-base sm:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl mx-auto lg:mx-0">
        Transformo datos en decisiones y valor de negocio mediante <b>Pipelines Escalables (Lakehouse & Streaming)</b>, <b>Modelos de Machine Learning en Producción (MLOps)</b> y <b>Sistemas Inteligentes con GenAI & RAG</b>. Combino principios sólidos de ingeniería de software con analítica avanzada.
      </p>

      <!-- Pill Highlights -->
      <div class="mt-6 flex flex-wrap justify-center lg:justify-start gap-2">
        <span class="px-3 py-1 text-xs font-mono font-medium rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700">
          ⚡ Data Engineering & Spark
        </span>
        <span class="px-3 py-1 text-xs font-mono font-medium rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700">
          📊 Predictive ML & Stats
        </span>
        <span class="px-3 py-1 text-xs font-mono font-medium rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700">
          🤖 GenAI & Enterprise RAG
        </span>
        <span class="px-3 py-1 text-xs font-mono font-medium rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700">
          🔄 MLOps & Cloud Architecture
        </span>
      </div>

      <!-- Action Buttons & Socials -->
      <div class="mt-8 flex flex-wrap items-center justify-center lg:justify-start gap-4">
        <a
          href="#projects"
          class="px-6 py-3 rounded-xl font-semibold text-sm bg-gradient-to-r from-teal-500 to-cyan-600 text-white shadow-lg shadow-teal-500/25 hover:shadow-teal-500/40 hover:opacity-95 transition-all transform hover:-translate-y-0.5"
        >
          Explorar Proyectos de Datos
        </a>
        <a
          href="#architecture"
          class="px-6 py-3 rounded-xl font-semibold text-sm bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-200 dark:hover:bg-neutral-750 transition-all"
        >
          Ver Arquitecturas
        </a>
      </div>

      <!-- Social Links -->
      <div class="mt-8 flex items-center justify-center lg:justify-start gap-3">
        <span class="text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider mr-2">
          Conecta:
        </span>
        
        <!-- GitHub -->
        <a
          href="https://github.com/fdaniel13s"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub de Fernando Quispe"
          class="w-9 h-9 flex items-center justify-center rounded-xl bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:text-teal-600 dark:hover:text-teal-400 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-all shadow-sm"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/fernando-quispe-5532901b4/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn de Fernando Quispe"
          class="w-9 h-9 flex items-center justify-center rounded-xl bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:text-cyan-600 dark:hover:text-cyan-400 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-all shadow-sm"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c.97 0 1.75-.79 1.75-1.76s-.78-1.75-1.75-1.75a1.76 1.76 0 0 0-1.76 1.75c0 .97.79 1.76 1.76 1.76m1.39 9.74v-8.37H5.07v8.37h2.78z"></path>
          </svg>
        </a>

        <!-- Email -->
        <a
          href="mailto:ferndani2718@gmail.com"
          aria-label="Email de contacto"
          class="w-9 h-9 flex items-center justify-center rounded-xl bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-all shadow-sm"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </a>

        <!-- YouTube -->
        <a
          href="https://www.youtube.com/@danifern2729"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Canal de YouTube"
          class="w-9 h-9 flex items-center justify-center rounded-xl bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:text-red-600 dark:hover:text-red-400 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-all shadow-sm"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Avatar & Visual Interactive Card -->
    <div class="flex-shrink-0 relative group">
      <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-teal-500 via-cyan-500 to-blue-600 opacity-60 blur-lg group-hover:opacity-90 transition duration-500 group-hover:duration-200"></div>
      
      <div class="relative w-64 h-64 sm:w-72 sm:h-72 rounded-3xl overflow-hidden bg-neutral-900 border-2 border-white/20 dark:border-neutral-700 shadow-2xl">
        <img
          class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
          src="/images/fernando-quispe.jpg"
          alt="Fernando Quispe - Data & AI Engineer"
          loading="eager"
        />
        
        <!-- Overlay Badge inside Photo Card -->
        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent p-4 text-left">
          <p class="text-white font-bold text-sm tracking-wide flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Fernando Quispe
          </p>
          <p class="text-neutral-300 text-xs font-mono">
            Data Pipelines & ML Engineering
          </p>
        </div>
      </div>
    </div>

  </div>

  <!-- Key Metrics Banner -->
  <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
    <div class="p-5 rounded-2xl bg-white/60 dark:bg-neutral-900/60 backdrop-blur-md border border-neutral-200/80 dark:border-neutral-800/80 shadow-sm text-center">
      <div class="text-3xl sm:text-4xl font-extrabold text-teal-600 dark:text-teal-400 font-mono">
        50k+
      </div>
      <div class="text-xs sm:text-sm font-medium text-neutral-600 dark:text-neutral-400 mt-1">
        Eventos/s en Streaming
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-white/60 dark:bg-neutral-900/60 backdrop-blur-md border border-neutral-200/80 dark:border-neutral-800/80 shadow-sm text-center">
      <div class="text-3xl sm:text-4xl font-extrabold text-cyan-600 dark:text-cyan-400 font-mono">
        98.2%
      </div>
      <div class="text-xs sm:text-sm font-medium text-neutral-600 dark:text-neutral-400 mt-1">
        Precisión en Extracción RAG
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-white/60 dark:bg-neutral-900/60 backdrop-blur-md border border-neutral-200/80 dark:border-neutral-800/80 shadow-sm text-center">
      <div class="text-3xl sm:text-4xl font-extrabold text-blue-600 dark:text-blue-400 font-mono">
        100%
      </div>
      <div class="text-xs sm:text-sm font-medium text-neutral-600 dark:text-neutral-400 mt-1">
        Data Quality & MLOps
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-white/60 dark:bg-neutral-900/60 backdrop-blur-md border border-neutral-200/80 dark:border-neutral-800/80 shadow-sm text-center">
      <div class="text-3xl sm:text-4xl font-extrabold text-purple-600 dark:text-purple-400 font-mono">
        &lt; 150ms
      </div>
      <div class="text-xs sm:text-sm font-medium text-neutral-600 dark:text-neutral-400 mt-1">
        Latencia p95 en Inferencia
      </div>
    </div>
  </div>
</section>
