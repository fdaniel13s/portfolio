---
// src/components/hero.astro
---

<section id="home" class="relative pt-28 sm:pt-36 pb-16 sm:pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
  
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
    
    <!-- Left Column: Name, Role & Call to Action (7 cols) -->
    <div class="order-2 lg:order-1 lg:col-span-7 text-center lg:text-left flex flex-col items-center lg:items-start z-10 w-full">
      
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs text-zinc-300 font-mono mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Software Engineer &bull; Enfocado en Data & AI</span>
      </div>

      <!-- Main Name -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
        Fernando <span class="text-cyan-400">Quispe</span>
      </h1>

      <!-- Professional Subtitle -->
      <p class="mt-3 text-lg sm:text-xl font-semibold text-zinc-200">
        Software Engineer <span class="text-cyan-400 font-normal">|</span> Data & AI
      </p>

      <!-- Concise Professional Bio -->
      <p class="mt-4 text-sm sm:text-base text-zinc-400 max-w-xl leading-relaxed text-center lg:text-left">
        Ingeniero de Software enfocado en el desarrollo de sistemas impulsados por datos e inteligencia artificial. Con experiencia práctica en analítica de datos, flujos ETL, bases de datos y desarrollo backend, expandiendo activamente capacidades en Data Engineering, Machine Learning y AI Agents.
      </p>

      <!-- 4 Prominent CTAs -->
      <div class="mt-8 flex flex-wrap items-center justify-center lg:justify-start gap-3 w-full sm:w-auto">
        <!-- View Projects -->
        <a
          href="#projects"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl font-semibold text-sm text-zinc-950 bg-white hover:bg-zinc-200 transition-all shadow-sm"
        >
          <span>Ver Proyectos</span>
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/fdaniel13s"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm text-zinc-300 bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-800 hover:text-white transition-all"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          <span>GitHub</span>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/fernando-quispe-5532901b4/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm text-zinc-300 bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-800 hover:text-white transition-all"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c.97 0 1.75-.79 1.75-1.76s-.78-1.75-1.75-1.75a1.76 1.76 0 0 0-1.76 1.75c0 .97.79 1.76 1.76 1.76m1.39 9.74v-8.37H5.07v8.37h2.78z"></path>
          </svg>
          <span>LinkedIn</span>
        </a>

        <!-- Download CV -->
        <a
          href="https://drive.google.com/file/d/1zpLKsT-llOvlMkJbGSawzjoeXDz0qFOf/view?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm text-cyan-400 bg-cyan-500/10 hover:bg-cyan-500/20 border border-cyan-500/30 transition-all"
        >
          <span>Descargar CV</span>
          <svg class="w-4 h-4 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </a>
      </div>

    </div>

    <!-- Right Column: Clean Avatar (5 cols) -->
    <div class="order-1 lg:order-2 lg:col-span-5 flex justify-center items-center relative z-10 w-full">
      <div class="relative w-52 h-52 sm:w-64 sm:h-64 lg:w-72 lg:h-72 rounded-2xl p-2 bg-gradient-to-b from-zinc-800/60 to-zinc-900/40 border border-zinc-800 shadow-xl mx-auto">
        <div class="w-full h-full rounded-xl overflow-hidden bg-zinc-950">
          <img
            src="/images/me.png"
            alt="Fernando Quispe"
            class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500"
            loading="eager"
          />
        </div>
      </div>
    </div>

  </div>

</section>
