---
// experience.astro
const experiences = [
  {
    period: "2023 - Presente",
    role: "Data & AI Solutions Developer",
    organization: "Proyectos de Impacto & Consultoría",
    description: "Diseño e implementación de plataformas de datos end-to-end: arquitecturas Lakehouse (Kafka, Spark, Delta Lake), pipelines RAG empresariales y despliegue de modelos de Machine Learning con explicabilidad SHAP y observabilidad con MLflow.",
    achievements: [
      "Diseño de arquitectura Lakehouse con latencia menor a 150ms para evaluación crediticia de comprobantes.",
      "Desarrollo de sistemas RAG híbridos logrando 98.2% de precisión en extracción de metadatos fiscales.",
      "Optimización de modelos predictivos y computer vision para agritech con 94.8% mAP50."
    ],
    skills: ["Apache Spark", "Apache Kafka", "LangChain", "Qdrant", "FastAPI", "dbt", "MLflow"]
  },
  {
    period: "2021 - 2024",
    role: "Software Engineer — Backend & Mobile Focus",
    organization: "Proyectos Académicos & Enterprise Apps",
    description: "Construcción de microservicios robustos y aplicaciones multiplataforma con Domain-Driven Design (DDD), patrones de diseño de software y metodologías ágiles.",
    achievements: [
      "Implementación de APIs RESTful con C# .NET Core y Java Spring Boot con alta concurrencia y cobertura de pruebas.",
      "Desarrollo de frontend reactivo con Vue.js/Angular y aplicaciones móviles nativas en Kotlin con Jetpack Compose.",
      "Configuración de pipelines CI/CD y despliegue contenerizado con Docker."
    ],
    skills: ["Java", "Spring Boot", "C#", ".NET Core", "Kotlin", "Docker", "PostgreSQL"]
  },
  {
    period: "2020 - Presente",
    role: "Ingeniería de Software",
    organization: "Universidad Peruana de Ciencias Aplicadas (UPC)",
    description: "Formación académica rigurosa en computación, estructuras de datos avanzadas, diseño de sistemas distribuidos, minería de datos e inteligencia artificial.",
    achievements: [
      "Liderazgo en proyectos interdisciplinarios de desarrollo de software y analítica aplicada.",
      "Especialización continua en Big Data, Machine Learning Engineering y Cloud Computing."
    ],
    skills: ["Algoritmos", "Estructuras de Datos", "Sistemas Distribuidos", "Arquitectura de Software", "Bases de Datos"]
  }
];
---

<section id="experience" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">
  
  <div class="text-center max-w-3xl mx-auto mb-16">
    <span class="text-neon-cyan font-bold text-sm tracking-wider uppercase">
      Experience
    </span>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mt-3 tracking-tight">
      Experiencia & Formación Académica
    </h2>
    <p class="mt-4 text-base text-neutral-300">
      Una base sólida de Ingeniería de Software aplicada a la resolución de problemas complejos en el ecosistema de Datos e Inteligencia Artificial.
    </p>
  </div>

  <div class="relative border-l-2 border-cosmic-border ml-4 md:ml-24 space-y-12">
    {experiences.map((item) => (
      <div class="relative pl-8 sm:pl-10 group">
        <!-- Timeline Marker Point (Neon Cyan) -->
        <div class="absolute -left-[9px] top-2 w-4 h-4 rounded-full bg-cosmic-950 border-2 border-neon-cyan group-hover:scale-125 group-hover:bg-neon-cyan transition-all duration-200 shadow-neon-cyan"></div>

        <div class="p-8 rounded-3xl bg-cosmic-card/85 backdrop-blur-md border border-cosmic-border hover:border-neon-cyan/50 hover:bg-cosmic-card-hover transition-all duration-300 shadow-cosmic-card">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
            <span class="text-xs font-mono font-bold text-neon-cyan bg-cosmic-900 px-3.5 py-1 rounded-full border border-cosmic-border self-start">
              {item.period}
            </span>
            <span class="text-xs text-neutral-400 font-medium">
              {item.organization}
            </span>
          </div>

          <h3 class="text-2xl font-bold text-white mt-3 group-hover:text-neon-cyan transition-colors">
            {item.role}
          </h3>

          <p class="text-sm text-neutral-300 mt-2 leading-relaxed">
            {item.description}
          </p>

          <!-- Key Highlights / Achievements -->
          <div class="mt-4 space-y-2">
            {item.achievements.map((ach) => (
              <div class="flex items-start gap-2.5 text-xs sm:text-sm text-neutral-300">
                <span class="text-neon-cyan font-bold">✓</span>
                <span>{ach}</span>
              </div>
            ))}
          </div>

          <!-- Technologies used in this stage -->
          <div class="mt-6 pt-4 border-t border-cosmic-border flex flex-wrap gap-1.5">
            {item.skills.map((skill) => (
              <span class="text-[11px] font-mono px-2.5 py-1 rounded-lg bg-cosmic-900 text-neutral-200 border border-cosmic-border">
                {skill}
              </span>
            ))}
          </div>

        </div>
      </div>
    ))}
  </div>
</section>
