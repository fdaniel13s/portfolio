---
// experience.astro
const experiences = [
  {
    period: "2023 - Presente",
    role: "Data & AI Solutions Developer",
    organization: "Proyectos de Impacto & Consultoría",
    description: "Diseño e implementación de plataformas de datos end-to-end: arquitecturas Lakehouse (Kafka, Spark, Delta Lake), pipelines RAG empresariales y despliegue de modelos de Machine Learning con explicabilidad SHAP y observabilidad con MLflow.",
    achievements: [
      "Diseño de arquitectura Lakehouse con latencia menor a 150ms para evaluación crediticia de comprobantes.",
      "Desarrollo de sistemas RAG híbridos logrando 98.2% de precisión en extracción de metadatos fiscales.",
      "Optimización de modelos predictivos y computer vision para agritech con 94.8% mAP50."
    ],
    skills: ["Apache Spark", "Apache Kafka", "LangChain", "Qdrant", "FastAPI", "dbt", "MLflow"]
  },
  {
    period: "2021 - 2024",
    role: "Software Engineer — Backend & Mobile Focus",
    organization: "Proyectos Académicos & Enterprise Apps",
    description: "Construcción de microservicios robustos y aplicaciones multiplataforma con Domain-Driven Design (DDD), patrones de diseño de software y metodologías ágiles.",
    achievements: [
      "Implementación de APIs RESTful con C# .NET Core y Java Spring Boot con alta concurrencia y cobertura de pruebas.",
      "Desarrollo de frontend reactivo con Vue.js/Angular y aplicaciones móviles nativas en Kotlin con Jetpack Compose.",
      "Configuración de pipelines CI/CD y despliegue contenerizado con Docker."
    ],
    skills: ["Java", "Spring Boot", "C#", ".NET Core", "Kotlin", "Docker", "PostgreSQL"]
  },
  {
    period: "2020 - Presente",
    role: "Ingeniería de Software",
    organization: "Universidad Peruana de Ciencias Aplicadas (UPC)",
    description: "Formación académica rigurosa en computación, estructuras de datos avanzadas, diseño de sistemas distribuidos, minería de datos e inteligencia artificial.",
    achievements: [
      "Liderazgo en proyectos interdisciplinarios de desarrollo de software y analítica aplicada.",
      "Especialización continua en Big Data, Machine Learning Engineering y Cloud Computing."
    ],
    skills: ["Algoritmos", "Estructuras de Datos", "Sistemas Distribuidos", "Arquitectura de Software", "Bases de Datos"]
  }
];
---

<section id="experience" class="py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <div class="text-center max-w-3xl mx-auto mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800 text-teal-700 dark:text-teal-300 text-xs font-semibold uppercase tracking-wider mb-3">
      Trayectoria
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 dark:text-white tracking-tight">
      Experiencia & Formación Académica
    </h2>
    <p class="mt-3 text-base text-neutral-600 dark:text-neutral-300">
      Una base sólida de Ingeniería de Software aplicada a la resolución de problemas complejos en el ecosistema de Datos e Inteligencia Artificial.
    </p>
  </div>

  <div class="relative border-l-2 border-teal-500/30 dark:border-teal-500/20 ml-4 md:ml-32 space-y-12">
    {experiences.map((item, idx) => (
      <div class="relative pl-8 sm:pl-10 group">
        <!-- Timeline Marker Point -->
        <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-white dark:bg-neutral-900 border-2 border-teal-500 group-hover:scale-125 group-hover:bg-teal-500 transition-all duration-200 shadow-sm shadow-teal-500/50"></div>

        <div class="p-6 sm:p-7 rounded-3xl bg-white/80 dark:bg-neutral-900/80 backdrop-blur-md border border-neutral-200/80 dark:border-neutral-800/80 shadow-sm hover:shadow-lg hover:border-teal-500/40 dark:hover:border-teal-500/40 transition-all duration-300">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
            <span class="text-xs font-mono font-bold text-teal-600 dark:text-teal-400 bg-teal-50 dark:bg-teal-950/60 px-3 py-1 rounded-lg self-start">
              {item.period}
            </span>
            <span class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">
              {item.organization}
            </span>
          </div>

          <h3 class="text-xl font-bold text-neutral-900 dark:text-white mt-2 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors">
            {item.role}
          </h3>

          <p class="text-sm text-neutral-600 dark:text-neutral-300 mt-2 leading-relaxed">
            {item.description}
          </p>

          <!-- Key Highlights / Achievements -->
          <div class="mt-4 space-y-1.5">
            {item.achievements.map((ach) => (
              <div class="flex items-start gap-2 text-xs sm:text-sm text-neutral-600 dark:text-neutral-300">
                <span class="text-teal-500 font-bold">✓</span>
                <span>{ach}</span>
              </div>
            ))}
          </div>

          <!-- Technologies used in this stage -->
          <div class="mt-5 pt-4 border-t border-neutral-100 dark:border-neutral-800 flex flex-wrap gap-1.5">
            {item.skills.map((skill) => (
              <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200/50 dark:border-neutral-700/50">
                {skill}
              </span>
            ))}
          </div>

        </div>
      </div>
    ))}
  </div>
</section>
