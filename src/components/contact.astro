---
// contact.astro
---

<section id="contact" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">
  <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-cosmic-800 via-cosmic-900 to-cosmic-950 border border-cosmic-border p-8 sm:p-14 text-center text-white shadow-2xl">
    
    <!-- Background Glows -->
    <div class="absolute -top-24 -left-24 w-80 h-80 bg-neon-cyan/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-neon-purple/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-2xl mx-auto">
      <span class="text-neon-cyan font-bold text-sm tracking-wider uppercase">
        Get Connected
      </span>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mt-3 mb-4">
        ¿Listo para transformar tus datos en una ventaja competitiva?
      </h2>

      <p class="text-base sm:text-lg text-neutral-300 mb-8 leading-relaxed">
        Ya sea para diseñar una arquitectura Lakehouse escalable, entrenar modelos de Machine Learning para producción o implementar agentes de IA / RAG empresarial, estaré encantado de colaborar.
      </p>

      <!-- Email Quick Copy and Action Container -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto mb-8">
        <div class="w-full flex items-center justify-between px-4 py-3 rounded-full bg-cosmic-950/90 border border-cosmic-border font-mono text-xs sm:text-sm text-neutral-200">
          <span id="email-text">ferndani2718@gmail.com</span>
          <button
            id="copy-email-btn"
            type="button"
            class="ml-2 px-4 py-1.5 rounded-full bg-cosmic-card hover:bg-neon-cyan hover:text-cosmic-950 text-neon-cyan font-sans text-xs font-bold transition-all border border-cosmic-border"
          >
            <span id="copy-btn-text">Copiar</span>
          </button>
        </div>

        <a
          href="mailto:ferndani2718@gmail.com"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-neon-cyan hover:bg-neon-cyan-hover text-cosmic-950 font-bold text-sm shadow-neon-cyan transition-all transform hover:scale-105 whitespace-nowrap"
        >
          Enviar Correo
        </a>
      </div>

      <!-- Social Networks Links (FolioX style) -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-6 border-t border-cosmic-border">
        <a
          href="https://www.linkedin.com/in/fernando-quispe-5532901b4/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-full bg-cosmic-card hover:bg-cosmic-card-hover text-xs font-bold text-neutral-200 hover:text-neon-cyan transition-colors flex items-center gap-2 border border-cosmic-border"
        >
          <span>LinkedIn</span>
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c.97 0 1.75-.79 1.75-1.76s-.78-1.75-1.75-1.75a1.76 1.76 0 0 0-1.76 1.75c0 .97.79 1.76 1.76 1.76m1.39 9.74v-8.37H5.07v8.37h2.78z"></path>
          </svg>
        </a>

        <a
          href="https://github.com/fdaniel13s"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-full bg-cosmic-card hover:bg-cosmic-card-hover text-xs font-bold text-neutral-200 hover:text-neon-cyan transition-colors flex items-center gap-2 border border-cosmic-border"
        >
          <span>GitHub</span>
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
        </a>

        <a
          href="https://drive.google.com/file/d/1zpLKsT-llOvlMkJbGSawzjoeXDz0qFOf/view?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-full bg-cosmic-card hover:bg-cosmic-card-hover text-xs font-bold text-neutral-200 hover:text-neon-cyan transition-colors flex items-center gap-2 border border-cosmic-border"
        >
          <span>Descargar CV (PDF)</span>
          <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  function setupContactCopy() {
    const copyBtn = document.getElementById('copy-email-btn');
    const copyText = document.getElementById('copy-btn-text');
    const emailStr = 'ferndani2718@gmail.com';

    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(emailStr);
          copyText.textContent = '¡Copiado!';
          copyBtn.classList.add('bg-neon-cyan', 'text-cosmic-950');
          setTimeout(() => {
            copyText.textContent = 'Copiar';
            copyBtn.classList.remove('bg-neon-cyan', 'text-cosmic-950');
          }, 2500);
        } catch (err) {
          copyText.textContent = 'ferndani2718@gmail.com';
        }
      });
    }
  }

  setupContactCopy();
  document.addEventListener('astro:page-load', setupContactCopy);
</script>

