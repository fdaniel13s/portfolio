---
// data-architecture.astro
const stages = [
  {
    step: "01",
    title: "Ingesta Batch & Streaming",
    icon: "⚡",
    desc: "Captura de eventos en tiempo real y micro-batches de múltiples fuentes (APIs, DBs, IoT, archivos).",
    techs: ["Apache Kafka", "AWS S3", "FastAPI", "CDC"],
    badge: "Ingestion"
  },
  {
    step: "02",
    title: "Lakehouse & Medallion",
    icon: "🏛️",
    desc: "Almacenamiento estructurado en capas Bronze (Raw), Silver (Clean/Enriched) y Gold (Business-Ready).",
    techs: ["Delta Lake", "DuckDB", "PostgreSQL", "Parquet"],
    badge: "Storage"
  },
  {
    step: "03",
    title: "Transformación & Data Quality",
    icon: "⚙️",
    desc: "Orquestación de pipelines con validación automatizada de esquemas, linaje y pruebas unitarias de datos.",
    techs: ["Apache Spark", "dbt Core", "Apache Airflow", "Great Expectations"],
    badge: "Processing"
  },
  {
    step: "04",
    title: "ML, GenAI & MLOps",
    icon: "🧠",
    desc: "Entrenamiento de modelos predictivos, pipelines RAG con bases vectoriales y registro de modelos en MLflow.",
    techs: ["PyTorch / Scikit-Learn", "LangChain / Qdrant", "MLflow", "SHAP"],
    badge: "Intelligence"
  },
  {
    step: "05",
    title: "Servicio & Toma de Decisiones",
    icon: "📊",
    desc: "Despliegue de endpoints de baja latencia (<150ms), microservicios contenerizados y dashboards analíticos.",
    techs: ["FastAPI", "Docker", "Streamlit", "Power BI"],
    badge: "Serving"
  }
];
---

<section id="architecture" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full relative z-10">
  
  <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
      Flujo End-to-End
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
      Arquitectura de Datos & Ciclo de IA
    </h2>
    <p class="mt-3 text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto">
      Cómo estructuro soluciones de datos resilientes desde la captura hasta el valor de negocio, uniendo ingeniería de datos, modelos de ML y aplicaciones de GenAI.
    </p>
  </div>

  <!-- Interactive Grid Flow -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {stages.map((stage) => (
      <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/80 hover:border-zinc-700 transition-colors flex flex-col justify-between group">
        
        <div>
          <!-- Header Card -->
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-medium px-2.5 py-0.5 rounded-md bg-zinc-800 text-cyan-400 border border-zinc-700/60">
              {stage.badge}
            </span>
            <span class="text-sm font-bold font-mono text-zinc-500">
              {stage.step}
            </span>
          </div>

          <!-- Title -->
          <div class="flex items-center gap-2.5 mb-2.5">
            <span class="text-lg">{stage.icon}</span>
            <h3 class="text-base font-bold text-white group-hover:text-cyan-400 transition-colors">
              {stage.title}
            </h3>
          </div>

          <!-- Description -->
          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-5">
            {stage.desc}
          </p>
        </div>

        <!-- Tech Badges -->
        <div class="pt-3 border-t border-zinc-800/70 flex flex-wrap gap-1.5">
          {stage.techs.map((tech) => (
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-zinc-800/70 text-zinc-300 border border-zinc-700/40">
              {tech}
            </span>
          ))}
        </div>
      </div>
    ))}

    <!-- High-Impact Value Box -->
    <div class="p-6 rounded-2xl bg-zinc-900/80 border border-zinc-700/70 text-white flex flex-col justify-between">
      <div>
        <span class="text-xs font-mono font-semibold px-2.5 py-0.5 rounded-md bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
          Principios de Ingeniería
        </span>
        <h3 class="text-base font-bold mt-4 mb-2 text-white">
          Garantía de Calidad & Escalabilidad
        </h3>
        <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
          Diseño arquitecturas desacopladas orientadas a eventos, pruebas automatizadas de datos con Great Expectations, versionado con Git y monitoreo constante en producción.
        </p>
      </div>
      
      <div class="pt-4 mt-4 border-t border-zinc-800 flex items-center justify-between text-xs text-zinc-400 font-mono">
        <span>CI/CD + DataOps</span>
        <span class="text-cyan-400">Zero Data Loss</span>
      </div>
    </div>
  </div>
</section>
