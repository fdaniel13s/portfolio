---
// src/components/data-architecture.astro
const stages = [
  {
    step: "01",
    title: "Fuentes de Datos",
    icon: "🔌",
    desc: "Bases relacionales transaccionales (OLTP), APIs REST, telemetría IoT y documentos no estructurados (facturas, PDF).",
    techs: ["PostgreSQL", "SQL Server", "APIs REST", "Archivos"],
    badge: "Sources"
  },
  {
    step: "02",
    title: "Ingesta & Buffer",
    icon: "⚡",
    desc: "Desacoplamiento elástico con Apache Kafka y recolección programada para absorber ráfagas sin degradar el origen.",
    techs: ["Apache Kafka", "FastAPI", "CDC", "Docker"],
    badge: "Ingestion"
  },
  {
    step: "03",
    title: "Transformación & Calidad",
    icon: "⚙️",
    desc: "Transformaciones SQL modulares con dbt Core, validaciones de esquema continuas y pipelines reproducibles con Python.",
    techs: ["dbt Core", "Apache Spark", "Great Expectations", "Python"],
    badge: "Processing"
  },
  {
    step: "04",
    title: "Almacenamiento Estructurado",
    icon: "🏛️",
    desc: "Capas organizadas (Bronze histórico, Silver limpio y Gold métricas) en Delta Lake, DuckDB y Data Warehouses.",
    techs: ["Delta Lake", "DuckDB", "Data Warehouse", "Parquet"],
    badge: "Storage"
  },
  {
    step: "05",
    title: "Capa de Inteligencia",
    icon: "🧠",
    desc: "Inferencia con modelos supervisados Scikit-Learn/XGBoost, explicabilidad SHAP e indexación vectorial densa con Qdrant.",
    techs: ["Scikit-Learn", "XGBoost", "Qdrant Vector DB", "LangChain"],
    badge: "Intelligence"
  },
  {
    step: "06",
    title: "Servicio & Aplicaciones",
    icon: "📊",
    desc: "Endpoints REST documentados con OpenAPI/Pydantic, microservicios backend y tableros interactivos para toma de decisiones.",
    techs: ["FastAPI", "Power BI", "Spring Boot", "Streamlit"],
    badge: "Serving"
  }
];

const designDecisions = [
  {
    title: "¿Por qué desacoplar Ingesta de Procesamiento?",
    answer: "Colocar un buffer de eventos (como Kafka) aísla a las fuentes transaccionales de fallas o lentitud en los consumidores downstream, garantizando idempotencia y tolerancia a fallos."
  },
  {
    title: "¿Por qué organización Medallion (Bronze/Silver/Gold)?",
    answer: "Bronze garantiza auditoría total al almacenar datos crudos sin modificar; Silver aplica reglas de negocio y deduplicación; Gold expone esquemas en estrella optimizados para consulta analítica."
  },
  {
    title: "¿Por qué contratos de datos y tipado estricto?",
    answer: "Validar esquemas en los límites del sistema (con Pydantic en APIs y tests automáticos en dbt) previene que datos corruptos o incompletos afecten los modelos analíticos o la experiencia de usuario."
  },
  {
    title: "¿Por qué RAG sobre modelos re-entrenados?",
    answer: "La recuperación aumentada (RAG) mantiene los datos actualizados al instante, reduce alucinaciones mediante citas explícitas a documentos fuente y es mucho más costo-eficiente que re-entrenar LLMs."
  }
];
---

<section id="architecture" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full relative z-10">
  
  <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
      Visión de Ingeniería
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
      Arquitectura de Datos & Ciclo de IA
    </h2>
    <p class="mt-3 text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto">
      Cómo pienso y diseño sistemas de datos como Software Engineer: flujo modular Sources &rarr; Processing &rarr; Storage &rarr; Intelligence &rarr; API &rarr; Application.
    </p>
  </div>

  <!-- Stages Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
    {stages.map((stage) => (
      <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/80 hover:border-zinc-700 transition-colors flex flex-col justify-between group">
        
        <div>
          <!-- Header Card -->
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-medium px-2.5 py-0.5 rounded-md bg-zinc-800 text-cyan-400 border border-zinc-700/60">
              {stage.badge}
            </span>
            <span class="text-sm font-bold font-mono text-zinc-500">
              {stage.step}
            </span>
          </div>

          <!-- Title -->
          <div class="flex items-center gap-2.5 mb-2.5">
            <span class="text-lg">{stage.icon}</span>
            <h3 class="text-base font-bold text-white group-hover:text-cyan-400 transition-colors">
              {stage.title}
            </h3>
          </div>

          <!-- Description -->
          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-5">
            {stage.desc}
          </p>
        </div>

        <!-- Tech Badges -->
        <div class="pt-3 border-t border-zinc-800/70 flex flex-wrap gap-1.5">
          {stage.techs.map((tech) => (
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-zinc-800/70 text-zinc-300 border border-zinc-700/40">
              {tech}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Engineering Decisions & Trade-offs Panel -->
  <div class="rounded-2xl bg-zinc-900/40 border border-zinc-800 p-6 sm:p-8">
    <div class="flex items-center gap-2 mb-6">
      <span class="text-cyan-400 font-mono text-sm">💡</span>
      <h3 class="text-lg font-bold text-white">
        Criterios de Diseño & Decisiones Técnicas (Engineering Decisions)
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {designDecisions.map((decision) => (
        <div class="p-4 rounded-xl bg-zinc-950/70 border border-zinc-800/70">
          <h4 class="text-xs sm:text-sm font-semibold text-zinc-200 mb-2 flex items-start gap-2">
            <span class="text-cyan-400 mt-0.5">&bull;</span>
            <span>{decision.title}</span>
          </h4>
          <p class="text-xs text-zinc-400 leading-relaxed pl-3.5">
            {decision.answer}
          </p>
        </div>
      ))}
    </div>
  </div>

</section>
