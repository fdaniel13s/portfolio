---
// data-architecture.astro
const stages = [
  {
    step: "01",
    title: "Ingesta Batch & Streaming",
    icon: "⚡",
    desc: "Captura de eventos en tiempo real y micro-batches de múltiples fuentes (APIs, DBs, IoT, archivos).",
    techs: ["Apache Kafka", "AWS S3", "FastAPI", "CDC"],
    badge: "Ingestion Layer"
  },
  {
    step: "02",
    title: "Lakehouse & Medallion",
    icon: "🏛️",
    desc: "Almacenamiento estructurado en capas Bronze (Raw), Silver (Clean/Enriched) y Gold (Business-Ready).",
    techs: ["Delta Lake", "DuckDB", "PostgreSQL", "Parquet"],
    badge: "Storage Layer"
  },
  {
    step: "03",
    title: "Transformación & Data Quality",
    icon: "⚙️",
    desc: "Orquestación de pipelines con validación automatizada de esquemas, linaje y pruebas unitarias de datos.",
    techs: ["Apache Spark", "dbt Core", "Apache Airflow", "Great Expectations"],
    badge: "Processing Layer"
  },
  {
    step: "04",
    title: "ML, GenAI & MLOps",
    icon: "🧠",
    desc: "Entrenamiento de modelos predictivos, pipelines RAG con bases vectoriales y registro de modelos en MLflow.",
    techs: ["PyTorch / Scikit-Learn", "LangChain / Qdrant", "MLflow", "SHAP"],
    badge: "Intelligence Layer"
  },
  {
    step: "05",
    title: "Servicio & Toma de Decisiones",
    icon: "📊",
    desc: "Despliegue de endpoints de baja latencia (<150ms), microservicios contenerizados y dashboards analíticos.",
    techs: ["FastAPI", "Docker", "Streamlit", "Power BI"],
    badge: "Serving Layer"
  }
];
---

<section id="architecture" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">
  
  <div class="text-center max-w-3xl mx-auto mb-16">
    <span class="text-neon-cyan font-bold text-sm tracking-wider uppercase">
      End-to-End Flow
    </span>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mt-3 tracking-tight">
      Arquitectura de Datos & Ciclo de IA
    </h2>
    <p class="mt-4 text-base text-neutral-300">
      Cómo estructuro soluciones de datos resilientes desde la captura hasta el impacto en negocio, combinando ingeniería de datos, modelos de ML y GenAI.
    </p>
  </div>

  <!-- Interactive Grid Flow -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 relative">
    {stages.map((stage) => (
      <div class="p-8 rounded-3xl bg-cosmic-card/85 backdrop-blur-md border border-cosmic-border hover:border-neon-cyan/50 hover:bg-cosmic-card-hover transition-all duration-300 shadow-cosmic-card flex flex-col justify-between group">
        
        <div>
          <!-- Header Card -->
          <div class="flex items-center justify-between mb-5">
            <span class="text-xs font-mono font-bold px-3 py-1 rounded-full bg-cosmic-900/90 text-neon-cyan border border-cosmic-border">
              {stage.badge}
            </span>
            <span class="text-xl font-black font-mono text-neon-cyan">
              {stage.step}
            </span>
          </div>

          <!-- Icon & Title -->
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">{stage.icon}</span>
            <h3 class="text-lg font-bold text-white group-hover:text-neon-cyan transition-colors">
              {stage.title}
            </h3>
          </div>

          <!-- Description -->
          <p class="text-sm text-neutral-300 leading-relaxed mb-6">
            {stage.desc}
          </p>
        </div>

        <!-- Tech Badges -->
        <div class="pt-4 border-t border-cosmic-border flex flex-wrap gap-1.5">
          {stage.techs.map((tech) => (
            <span class="text-[11px] font-mono px-2.5 py-1 rounded-lg bg-cosmic-900 text-neutral-200 border border-cosmic-border/60">
              {tech}
            </span>
          ))}
        </div>
      </div>
    ))}

    <!-- High-Impact Value Box -->
    <div class="p-8 rounded-3xl bg-gradient-to-br from-cosmic-800 to-cosmic-950 border border-neon-cyan/30 text-white shadow-2xl flex flex-col justify-between overflow-hidden relative group">
      <div class="absolute -right-8 -bottom-8 w-40 h-40 bg-neon-cyan/15 rounded-full blur-2xl pointer-events-none"></div>
      <div>
        <span class="text-xs font-mono font-bold px-3 py-1 rounded-full bg-neon-cyan/20 text-neon-cyan border border-neon-cyan/40">
          Core Engineering Principles
        </span>
        <h3 class="text-xl font-bold mt-5 mb-3 text-white">
          Garantía de Calidad & Escalabilidad
        </h3>
        <p class="text-sm text-neutral-300 leading-relaxed">
          Diseño arquitecturas desacopladas orientadas a eventos, reproducibilidad con DVC/Git, observabilidad integral y monitoreo de <i>data drift</i> en producción.
        </p>
      </div>
      
      <div class="pt-5 mt-5 border-t border-cosmic-border flex items-center justify-between text-xs text-neon-cyan font-mono">
        <span>CI/CD + DataOps</span>
        <span>Zero Data Loss</span>
      </div>
    </div>
  </div>
</section>
