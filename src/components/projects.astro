---
// src/components/projects.astro
import { projects, CATEGORIES } from '../data/projects';

const featuredProjects = projects.filter((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);
---

<section id="projects" class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full relative z-10">
  
  <!-- Section Header -->
  <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
      Portfolio Técnico & Casos de Estudio
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
      Proyectos Destacados
    </h2>
    <p class="mt-3 text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto">
      Selección de proyectos organizados como pequeños casos de estudio: problema, solución, arquitectura end-to-end, decisiones técnicas y código verificable.
    </p>
  </div>

  <!-- Filter Category Buttons -->
  <div class="flex flex-wrap justify-center items-center gap-2 sm:gap-2.5 mb-12" id="project-filters">
    {CATEGORIES.map((cat, idx) => (
      <button
        type="button"
        data-filter={cat.id}
        class={`project-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 ${
          idx === 0
            ? "bg-white text-zinc-950 shadow-sm font-semibold active-filter"
            : "bg-zinc-900/80 text-zinc-400 border border-zinc-800 hover:text-zinc-200 hover:border-zinc-700"
        }`}
      >
        {cat.label}
      </button>
    ))}
  </div>

  <!-- Featured Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
    {featuredProjects.map((project) => (
      <article
        data-category={project.category}
        class="project-card flex flex-col justify-between rounded-2xl bg-zinc-900/60 border border-zinc-800/80 hover:border-zinc-700 hover:bg-zinc-900/90 transition-all duration-300 overflow-hidden group shadow-sm"
      >
        <div>
          <!-- Project Image Preview -->
          <div class="relative w-full aspect-[16/10] bg-zinc-950 overflow-hidden border-b border-zinc-800/70">
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent opacity-60"></div>
            
            <!-- Category Badge -->
            <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-mono font-medium bg-zinc-900/90 text-cyan-400 border border-zinc-700/60 backdrop-blur-md">
                {project.categoryLabel}
              </span>
            </div>

            <!-- Project Type Badge -->
            <div class="absolute bottom-3 right-3">
              <span class="px-2.5 py-0.5 rounded-md text-[11px] font-mono font-semibold bg-zinc-950/90 text-zinc-300 border border-zinc-800 backdrop-blur-md">
                {project.projectType}
              </span>
            </div>
          </div>

          <!-- Content Body -->
          <div class="p-5 sm:p-6">
            <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition-colors line-clamp-2">
              {project.title}
            </h3>

            <p class="mt-2.5 text-sm text-zinc-400 leading-relaxed line-clamp-3">
              {project.shortDescription}
            </p>

            <!-- Tags -->
            <div class="mt-4 flex flex-wrap gap-1.5">
              {project.tags.slice(0, 5).map((tag) => (
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-800/70 text-zinc-300 border border-zinc-700/50">
                  {tag}
                </span>
              ))}
              {project.tags.length > 5 && (
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-800/40 text-zinc-500">
                  +{project.tags.length - 5}
                </span>
              )}
            </div>
          </div>
        </div>

        <!-- Card Footer / Actions -->
        <div class="p-5 sm:p-6 pt-0 mt-2 flex flex-wrap items-center gap-2.5">
          <!-- View Case Study Button -->
          <button
            type="button"
            data-open-modal={project.id}
            class="open-modal-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 text-xs font-semibold border border-cyan-500/30 transition-colors"
          >
            <span>Caso de Estudio</span>
            <svg class="w-3.5 h-3.5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          {project.github && (
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-zinc-800/80 hover:bg-zinc-700 text-zinc-200 text-xs font-medium border border-zinc-700/60 transition-colors"
              title="Ver código en GitHub"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
              <span>GitHub</span>
            </a>
          )}

          {project.liveDemo && (
            <a
              href={project.liveDemo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-zinc-800/80 hover:bg-zinc-700 text-zinc-300 text-xs font-medium border border-zinc-700/60 transition-colors"
            >
              <span>Demo</span>
              <svg class="w-3.5 h-3.5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>
      </article>
    ))}
  </div>

  <!-- More Projects Section -->
  {otherProjects.length > 0 && (
    <div class="mt-16 pt-12 border-t border-zinc-800/80">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h3 class="text-xl font-bold text-white">
            Otros Proyectos & Experimentos
          </h3>
          <p class="text-xs sm:text-sm text-zinc-400 mt-1">
            Prototipos complementarios de Machine Learning y desarrollo de software.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {otherProjects.map((project) => (
          <article class="p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800/70 hover:border-zinc-700 transition-colors flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-mono text-cyan-400 bg-zinc-800 px-2.5 py-0.5 rounded-md border border-zinc-700/60">
                  {project.categoryLabel}
                </span>
                <span class="text-[11px] font-mono text-zinc-400">
                  {project.projectType}
                </span>
              </div>

              <h4 class="text-base font-bold text-white mb-2">
                {project.title}
              </h4>

              <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-4">
                {project.shortDescription}
              </p>

              <div class="flex flex-wrap gap-1.5 mb-5">
                {project.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-800/70 text-zinc-300 border border-zinc-700/40">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-zinc-800/60 flex items-center justify-between">
              <button
                type="button"
                data-open-modal={project.id}
                class="open-modal-btn text-xs font-mono font-medium text-cyan-400 hover:text-cyan-300 hover:underline"
              >
                Ver Detalles &rarr;
              </button>

              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-zinc-400 hover:text-white flex items-center gap-1 font-mono"
                >
                  <span>Repo</span>
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  )}

  <!-- Case Study Modals Container -->
  {projects.map((project) => (
    <div
      id={`modal-${project.id}`}
      class="project-modal fixed inset-0 z-50 hidden overflow-y-auto bg-zinc-950/80 backdrop-blur-md p-4 sm:p-6 lg:p-10 flex items-center justify-center"
      role="dialog"
      aria-modal="true"
      aria-labelledby={`modal-title-${project.id}`}
    >
      <div class="relative w-full max-w-3xl rounded-2xl bg-zinc-900 border border-zinc-700 shadow-2xl overflow-hidden my-auto text-left">
        
        <!-- Modal Top Bar -->
        <div class="p-6 sm:p-7 border-b border-zinc-800 flex items-start justify-between gap-4 bg-zinc-950/60">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="text-xs font-mono font-medium px-2.5 py-0.5 rounded bg-zinc-800 text-cyan-400 border border-zinc-700">
                {project.categoryLabel}
              </span>
              <span class="text-xs font-mono text-zinc-400 bg-zinc-900 px-2.5 py-0.5 rounded border border-zinc-800">
                {project.projectType}
              </span>
            </div>
            <h3 id={`modal-title-${project.id}`} class="text-xl sm:text-2xl font-extrabold text-white">
              {project.title}
            </h3>
          </div>

          <button
            type="button"
            data-close-modal={project.id}
            class="p-2 rounded-xl text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors flex-shrink-0"
            aria-label="Cerrar modal"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Modal Body Content -->
        <div class="p-6 sm:p-7 space-y-6 max-h-[70vh] overflow-y-auto">
          
          <!-- Problem & Solution -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="p-4 rounded-xl bg-zinc-950/60 border border-zinc-800/80">
              <span class="text-xs font-mono text-red-400 font-semibold block mb-1.5 uppercase tracking-wider">
                1. El Problema
              </span>
              <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed">
                {project.problem}
              </p>
            </div>

            <div class="p-4 rounded-xl bg-zinc-950/60 border border-zinc-800/80">
              <span class="text-xs font-mono text-emerald-400 font-semibold block mb-1.5 uppercase tracking-wider">
                2. La Solución
              </span>
              <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed">
                {project.solution}
              </p>
            </div>
          </div>

          <!-- Architecture Breakdown -->
          <div class="p-5 rounded-xl bg-zinc-950/70 border border-zinc-800">
            <span class="text-xs font-mono text-cyan-400 font-semibold block mb-3 uppercase tracking-wider">
              3. Componentes de la Arquitectura
            </span>
            <div class="space-y-2 text-xs font-mono">
              <div class="flex items-start gap-2 text-zinc-300">
                <span class="text-cyan-400 font-bold min-w-[90px]">&bull; Sources:</span>
                <span class="text-zinc-400">{project.architecture.sources}</span>
              </div>
              <div class="flex items-start gap-2 text-zinc-300">
                <span class="text-cyan-400 font-bold min-w-[90px]">&bull; Processing:</span>
                <span class="text-zinc-400">{project.architecture.processing}</span>
              </div>
              <div class="flex items-start gap-2 text-zinc-300">
                <span class="text-cyan-400 font-bold min-w-[90px]">&bull; Storage:</span>
                <span class="text-zinc-400">{project.architecture.storage}</span>
              </div>
              {project.architecture.intelligence && (
                <div class="flex items-start gap-2 text-zinc-300">
                  <span class="text-cyan-400 font-bold min-w-[90px]">&bull; ML / AI:</span>
                  <span class="text-zinc-400">{project.architecture.intelligence}</span>
                </div>
              )}
              {project.architecture.api && (
                <div class="flex items-start gap-2 text-zinc-300">
                  <span class="text-cyan-400 font-bold min-w-[90px]">&bull; API:</span>
                  <span class="text-zinc-400">{project.architecture.api}</span>
                </div>
              )}
              {project.architecture.application && (
                <div class="flex items-start gap-2 text-zinc-300">
                  <span class="text-cyan-400 font-bold min-w-[90px]">&bull; App/UI:</span>
                  <span class="text-zinc-400">{project.architecture.application}</span>
                </div>
              )}
            </div>
          </div>

          <!-- Engineering Decisions -->
          <div>
            <span class="text-xs font-mono text-zinc-300 font-semibold block mb-3 uppercase tracking-wider">
              4. Decisiones Técnicas (Engineering Decisions)
            </span>
            <div class="space-y-3">
              {project.decisions.map((dec) => (
                <div class="p-3.5 rounded-xl bg-zinc-950/40 border border-zinc-800">
                  <h5 class="text-xs sm:text-sm font-bold text-zinc-200 mb-1">
                    {dec.question}
                  </h5>
                  <p class="text-xs text-zinc-400 leading-relaxed">
                    {dec.answer}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <!-- Results & Outcomes -->
          <div>
            <span class="text-xs font-mono text-zinc-300 font-semibold block mb-2 uppercase tracking-wider">
              5. Resultados & Entregables Verificables
            </span>
            <ul class="space-y-1.5 text-xs sm:text-sm text-zinc-300">
              {project.results.map((res) => (
                <li class="flex items-start gap-2">
                  <span class="text-cyan-400 mt-0.5">&bull;</span>
                  <span>{res}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Stack -->
          <div>
            <span class="text-xs font-mono text-zinc-400 block mb-2 uppercase tracking-wider">
              Tecnologías Utilizadas:
            </span>
            <div class="flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="px-2.5 py-1 rounded text-xs font-mono bg-zinc-800 text-zinc-300 border border-zinc-700/60">
                  {tag}
                </span>
              ))}
            </div>
          </div>

        </div>

        <!-- Modal Footer Links -->
        <div class="p-5 sm:p-6 border-t border-zinc-800 bg-zinc-950/60 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white text-zinc-950 text-xs font-bold hover:bg-zinc-200 transition-colors"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                </svg>
                <span>Ver Repositorio</span>
              </a>
            )}
            {project.liveDemo && (
              <a
                href={project.liveDemo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 text-xs font-semibold hover:bg-cyan-500/20 transition-colors"
              >
                <span>Live Demo</span>
                <svg class="w-3.5 h-3.5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
          </div>

          <button
            type="button"
            data-close-modal={project.id}
            class="px-4 py-2 rounded-xl text-xs font-medium text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors"
          >
            Cerrar
          </button>
        </div>

      </div>
    </div>
  ))}

</section>

<!-- Filter and Modal Script -->
<script is:inline>
  function setupProjectsInteraction() {
    // Filter logic
    const filterButtons = document.querySelectorAll('.project-filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetCategory = btn.getAttribute('data-filter');

        filterButtons.forEach((b) => {
          b.classList.remove('bg-white', 'text-zinc-950', 'shadow-sm', 'font-semibold', 'active-filter');
          b.classList.add('bg-zinc-900/80', 'text-zinc-400', 'border-zinc-800');
        });
        btn.classList.remove('bg-zinc-900/80', 'text-zinc-400', 'border-zinc-800');
        btn.classList.add('bg-white', 'text-zinc-950', 'shadow-sm', 'font-semibold', 'active-filter');

        projectCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (targetCategory === 'all' || cardCat === targetCategory) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Modal open/close logic
    const openButtons = document.querySelectorAll('[data-open-modal]');
    const closeButtons = document.querySelectorAll('[data-close-modal]');
    const modals = document.querySelectorAll('.project-modal');

    function openModal(id) {
      const modal = document.getElementById(`modal-${id}`);
      if (modal) {
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal(id) {
      const modal = document.getElementById(`modal-${id}`);
      if (modal) {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    openButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-open-modal');
        if (id) openModal(id);
      });
    });

    closeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-close-modal');
        if (id) closeModal(id);
      });
    });

    // Backdrop click and Escape key support
    modals.forEach((modal) => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
          document.body.style.overflow = '';
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        modals.forEach((m) => m.classList.add('hidden'));
        document.body.style.overflow = '';
      }
    });
  }

  setupProjectsInteraction();
  document.addEventListener('astro:page-load', setupProjectsInteraction);
</script>