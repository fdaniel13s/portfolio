const filterCategories = [
  { id: "all", label: "Todos los Proyectos", icon: "🌐" },
  { id: "data-eng", label: "Data Engineering", icon: "⚡" },
  { id: "data-science", label: "Data Science & ML", icon: "📊" },
  { id: "gen-ai", label: "Generative AI & LLMs", icon: "🤖" },
];
---

<section id="projects" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10">
  
  <!-- Section Header (FolioX style) -->
  <div class="text-center max-w-3xl mx-auto mb-16">
    <span class="text-neon-cyan font-bold text-sm tracking-wider uppercase">
      Portfolio
    </span>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mt-3 tracking-tight">
      Casos de Estudio & Soluciones de Datos
    </h2>
    <p class="mt-4 text-base text-neutral-300">
      Proyectos desarrollados con estándares de producción: arquitectura de datos, pipelines escalables, modelos de ML explicables y sistemas de IA Generativa.
    </p>
  </div>

  <!-- Filter Category Buttons (Pill style) -->
  <div class="flex flex-wrap justify-center gap-3 mb-12" id="project-filters">
    {filterCategories.map((cat, idx) => (
      <button
        type="button"
        data-filter={cat.id}
        class={`project-filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center gap-2 ${
          idx === 0
            ? "bg-neon-cyan text-cosmic-950 shadow-neon-cyan active-filter"
            : "bg-cosmic-card text-neutral-300 border border-cosmic-border hover:border-neon-cyan/40 hover:text-white"
        }`}
      >
        <span>{cat.icon}</span>
        <span>{cat.label}</span>
      </button>
    ))}
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8" id="projects-grid">
    {projects.map((project) => (
      <article
        data-category={project.category}
        class="project-card flex flex-col justify-between rounded-3xl bg-cosmic-card/85 backdrop-blur-md border border-cosmic-border hover:border-neon-cyan/50 hover:bg-cosmic-card-hover transition-all duration-300 shadow-cosmic-card overflow-hidden group"
      >
        <div>
          <!-- Image Container / Carousel -->
          <div class="relative w-full h-60 bg-cosmic-950 overflow-hidden border-b border-cosmic-border">
            <div class="carousel-container relative w-full h-full">
              {project.images.map((img, idx) => (
                <img
                  src={img}
                  alt={`${project.title} - Captura ${idx + 1}`}
                  class={`carousel-img absolute inset-0 w-full h-full object-cover transition-all duration-500 group-hover:scale-105 ${
                    idx === 0 ? "opacity-100 scale-100" : "opacity-0 scale-100"
                  }`}
                  loading="lazy"
                />
              ))}
            </div>

            <!-- Gradient Overlay for Contrast -->
            <div class="absolute inset-0 bg-gradient-to-t from-cosmic-950 via-cosmic-950/20 to-transparent pointer-events-none"></div>

            <!-- Domain Badge -->
            <div class="absolute top-4 left-4 z-10">
              <span class={`px-3.5 py-1 rounded-full text-xs font-semibold font-mono border backdrop-blur-md ${project.badgeClass}`}>
                {project.categoryLabel}
              </span>
            </div>

            <!-- Carousel Controls if multiple images -->
            {project.images.length > 1 && (
              <div class="absolute bottom-3 right-3 z-10 flex gap-1.5">
                <button
                  type="button"
                  class="carousel-prev w-8 h-8 rounded-full bg-cosmic-950/80 hover:bg-neon-cyan hover:text-cosmic-950 text-white flex items-center justify-center text-xs backdrop-blur-sm transition-colors border border-cosmic-border"
                  aria-label="Imagen anterior"
                >
                  ‹
                </button>
                <button
                  type="button"
                  class="carousel-next w-8 h-8 rounded-full bg-cosmic-950/80 hover:bg-neon-cyan hover:text-cosmic-950 text-white flex items-center justify-center text-xs backdrop-blur-sm transition-colors border border-cosmic-border"
                  aria-label="Siguiente imagen"
                >
                  ›
                </button>
              </div>
            )}
          </div>

          <!-- Content Body -->
          <div class="p-7 sm:p-8">
            <!-- Title & Subtitle -->
            <h3 class="text-2xl font-bold text-white group-hover:text-neon-cyan transition-colors leading-tight">
              {project.title}
            </h3>
            <p class="text-sm font-medium text-neon-cyan mt-1.5 mb-5">
              {project.subtitle}
            </p>

            <!-- Problem & Business Context -->
            <div class="mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-neutral-400 block mb-1">
                📌 Reto & Impacto de Negocio
              </span>
              <p class="text-sm text-neutral-300 leading-relaxed">
                {project.problem}
              </p>
            </div>

            <!-- Data Architecture & Pipeline -->
            <div class="mb-5">
              <span class="text-xs font-bold uppercase tracking-wider text-neutral-400 block mb-1">
                🏛️ Arquitectura & Pipeline de Datos
              </span>
              <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed bg-cosmic-900/90 p-3.5 rounded-2xl border border-cosmic-border font-sans">
                {project.architecture}
              </p>
            </div>

            <!-- Key Metrics Grid -->
            <div class="grid grid-cols-3 gap-2 py-3 px-3.5 mb-5 rounded-2xl bg-cosmic-900/80 border border-cosmic-border text-center">
              {project.metrics.map((metric) => (
                <div>
                  <div class="text-sm sm:text-base font-bold font-mono text-neon-cyan">
                    {metric.value}
                  </div>
                  <div class="text-[10px] sm:text-[11px] text-neutral-400 mt-0.5 leading-tight">
                    {metric.label}
                  </div>
                </div>
              ))}
            </div>

            <!-- Technologies -->
            <div class="mb-6">
              <span class="text-xs font-bold uppercase tracking-wider text-neutral-400 block mb-2">
                Stack Tecnológico:
              </span>
              <div class="flex flex-wrap gap-1.5">
                {project.technologies.map((tech) => (
                  <span class="text-[11px] font-mono px-2.5 py-1 rounded-lg bg-cosmic-900 text-neutral-200 border border-cosmic-border">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Card Footer / Links -->
        <div class="px-7 sm:px-8 pb-7 pt-3 border-t border-cosmic-border flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            {project.github && project.github.map((link, idx) => (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-bold bg-cosmic-900 text-white hover:bg-neon-cyan hover:text-cosmic-950 border border-cosmic-border transition-all"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                </svg>
                <span>{project.github.length > 1 ? `Repo ${idx + 1}` : 'Código Fuente'}</span>
              </a>
            ))}
          </div>

          <a
            href="mailto:ferndani2718@gmail.com?subject=Consulta%20sobre%20proyecto%20"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-neon-cyan hover:underline"
          >
            <span>Consultar caso</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<script is:inline>
  function setupProjectsInteraction() {
    // Category Filtering
    const filterBtns = document.querySelectorAll('.project-filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Reset buttons style
        filterBtns.forEach(b => {
          b.classList.remove('bg-neon-cyan', 'text-cosmic-950', 'shadow-neon-cyan', 'active-filter');
          b.classList.add('bg-cosmic-card', 'text-neutral-300', 'border', 'border-cosmic-border');
        });

        // Highlight active button
        btn.classList.remove('bg-cosmic-card', 'text-neutral-300', 'border');
        btn.classList.add('bg-neon-cyan', 'text-cosmic-950', 'shadow-neon-cyan', 'active-filter');

        // Filter projects
        projectCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          if (filter === 'all' || cardCategory === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Image Carousels
    const cardsWithCarousels = document.querySelectorAll('.project-card');
    cardsWithCarousels.forEach(card => {
      const images = card.querySelectorAll('.carousel-img');
      if (images.length <= 1) return;

      const prevBtn = card.querySelector('.carousel-prev');
      const nextBtn = card.querySelector('.carousel-next');
      let currentIndex = 0;

      function updateCarousel(newIndex) {
        images.forEach((img, idx) => {
          if (idx === newIndex) {
            img.classList.remove('opacity-0');
            img.classList.add('opacity-100');
          } else {
            img.classList.remove('opacity-100');
            img.classList.add('opacity-0');
          }
        });
        currentIndex = newIndex;
      }

      if (prevBtn && nextBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const newIdx = (currentIndex - 1 + images.length) % images.length;
          updateCarousel(newIdx);
        });

        nextBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const newIdx = (currentIndex + 1) % images.length;
          updateCarousel(newIdx);
        });
      }
    });
  }

  setupProjectsInteraction();
  document.addEventListener('astro:page-load', setupProjectsInteraction);
</script>